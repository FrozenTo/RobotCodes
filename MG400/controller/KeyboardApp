import sys
import time
import threading

from pynput import keyboard

from PySide6.QtCore import Signal, QObject
from PySide6.QtWidgets import (
    QApplication,
    QWidget,
    QVBoxLayout,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QLineEdit,
    QSpinBox,
    QGroupBox,
    QMessageBox,
)

from dobot_api import DobotApiDashboard, DobotApiMove


DEFAULT_IP = "192.168.2.6"


# =========================================================
# Signals from keyboard thread -> Qt GUI
# =========================================================

class Signals(QObject):
    direction_changed = Signal(str)
    status_changed = Signal(str)
    tool1_changed = Signal(bool)
    tool2_changed = Signal(bool)
    request_close = Signal()


# =========================================================
# Robot controller
# =========================================================

class MG400Controller:
    def __init__(self, signals):
        self.signals = signals

        self.dashboard = None
        self.move = None

        self.connected = False
        self.enabled = False

        self.tool1_on = False
        self.tool2_on = False

        self.pressed_keys = []
        self.current_direction = None

        self.lock = threading.Lock()

    # -----------------------------------------------------
    # Connection
    # -----------------------------------------------------

    def connect_robot(self, ip, speed):
        try:
            self.signals.status_changed.emit("Connecting...")

            self.dashboard = DobotApiDashboard(ip, 29999)
            self.move = DobotApiMove(ip, 30003)

            self.connected = True

            print("ClearError:", self.dashboard.ClearError())

            # You tested this — 1 second works well
            time.sleep(1)

            print("EnableRobot:", self.dashboard.EnableRobot())

            time.sleep(0.5)

            print("SpeedFactor:", self.dashboard.SpeedFactor(speed))

            self.enabled = True

            self.signals.status_changed.emit(
                f"Connected + Enabled ({ip})"
            )

        except Exception as e:
            self.connected = False
            self.enabled = False

            self.signals.status_changed.emit(
                f"Connection failed: {e}"
            )

            raise

    def set_speed(self, speed):
        if not self.connected:
            return

        try:
            print("SpeedFactor:", self.dashboard.SpeedFactor(speed))
        except Exception as e:
            print("Speed error:", e)

    # -----------------------------------------------------
    # Jog control
    # -----------------------------------------------------

    def jog(self, direction):
        if not self.connected or not self.enabled:
            return

        try:
            self.move.MoveJog(direction)

            self.current_direction = direction

            self.signals.direction_changed.emit(direction)

            print("Jog:", direction)

        except Exception as e:
            print("Jog error:", e)

    def stop(self):
        if self.move is None:
            return

        try:
            self.move.MoveJog()

        except Exception as e:
            print("Stop error:", e)

        self.current_direction = None

        self.signals.direction_changed.emit("STOP")

        print("STOP")

    # -----------------------------------------------------
    # Tool outputs
    # -----------------------------------------------------

    def set_tool1(self, state):
        if not self.connected:
            return

        try:
            self.dashboard.DO(1, 1 if state else 0)

            self.tool1_on = state

            self.signals.tool1_changed.emit(state)

            print("Tool 1:", "ON" if state else "OFF")

        except Exception as e:
            print("Tool 1 error:", e)

    def set_tool2(self, state):
        if not self.connected:
            return

        try:
            self.dashboard.DO(2, 1 if state else 0)

            self.tool2_on = state

            self.signals.tool2_changed.emit(state)

            print("Tool 2:", "ON" if state else "OFF")

        except Exception as e:
            print("Tool 2 error:", e)

    # -----------------------------------------------------
    # Disable
    # -----------------------------------------------------

    def disable(self):
        with self.lock:
            self.pressed_keys.clear()

        self.stop()

        if not self.connected:
            return

        try:
            # Safer default when shutting down
            self.set_tool1(False)
            self.set_tool2(False)

            print("DisableRobot:", self.dashboard.DisableRobot())

        except Exception as e:
            print("Disable error:", e)

        self.enabled = False

        self.signals.status_changed.emit("Robot disabled")

    # -----------------------------------------------------
    # Keyboard mapping
    # -----------------------------------------------------

    def key_to_direction(self, key):

        if key == keyboard.Key.up:
            return "X-"

        if key == keyboard.Key.down:
            return "X+"

        if key == keyboard.Key.left:
            return "Y-"

        if key == keyboard.Key.right:
            return "Y+"

        if key in (
            keyboard.Key.shift,
            keyboard.Key.shift_l,
            keyboard.Key.shift_r,
        ):
            return "Z+"

        if key in (
            keyboard.Key.ctrl,
            keyboard.Key.ctrl_l,
            keyboard.Key.ctrl_r,
        ):
            return "Z-"

        return None

    # -----------------------------------------------------
    # Keyboard press
    # -----------------------------------------------------

    def key_pressed(self, key):

        # SPACE = immediate stop
        if key == keyboard.Key.space:

            with self.lock:
                self.pressed_keys.clear()

            self.stop()

            return

        # ESC = stop + disable + close
        if key == keyboard.Key.esc:

            self.disable()

            self.signals.request_close.emit()

            return False

        direction = self.key_to_direction(key)

        if direction is None:
            return

        with self.lock:

            # Ignore Windows keyboard repeat
            if key in self.pressed_keys:
                return

            self.pressed_keys.append(key)

        # Last pressed key wins
        self.jog(direction)

    # -----------------------------------------------------
    # Keyboard release
    # -----------------------------------------------------

    def key_released(self, key):

        direction = self.key_to_direction(key)

        if direction is None:
            return

        with self.lock:

            if key not in self.pressed_keys:
                return

            was_last = (
                self.pressed_keys
                and self.pressed_keys[-1] == key
            )

            self.pressed_keys.remove(key)

            remaining = list(self.pressed_keys)

        # If released key wasn't controlling movement,
        # nothing needs to change.
        if not was_last:
            return

        # Another movement key is still held
        if remaining:

            previous_key = remaining[-1]

            previous_direction = self.key_to_direction(
                previous_key
            )

            if previous_direction:
                self.jog(previous_direction)

        else:
            self.stop()


# =========================================================
# GUI
# =========================================================

class MainWindow(QWidget):

    def __init__(self):
        super().__init__()

        self.setWindowTitle("MG400 Keyboard Controller")
        self.resize(440, 600)

        self.signals = Signals()
        self.robot = MG400Controller(self.signals)

        self.keyboard_listener = None

        self.build_ui()
        self.connect_signals()
        self.start_keyboard_listener()

    # -----------------------------------------------------
    # UI
    # -----------------------------------------------------

    def build_ui(self):

        main = QVBoxLayout(self)

        # ============================
        # Connection
        # ============================

        connection_group = QGroupBox("Robot")
        connection_layout = QVBoxLayout()

        ip_row = QHBoxLayout()

        ip_row.addWidget(QLabel("IP:"))

        self.ip_input = QLineEdit(DEFAULT_IP)

        ip_row.addWidget(self.ip_input)

        connection_layout.addLayout(ip_row)

        speed_row = QHBoxLayout()

        speed_row.addWidget(QLabel("Speed:"))

        self.speed_input = QSpinBox()
        self.speed_input.setRange(1, 100)
        self.speed_input.setValue(20)
        self.speed_input.setSuffix(" %")

        speed_row.addWidget(self.speed_input)

        connection_layout.addLayout(speed_row)

        button_row = QHBoxLayout()

        self.connect_button = QPushButton(
            "Connect + Enable"
        )

        self.disable_button = QPushButton(
            "Disable"
        )

        button_row.addWidget(self.connect_button)
        button_row.addWidget(self.disable_button)

        connection_layout.addLayout(button_row)

        self.status_label = QLabel("Disconnected")

        connection_layout.addWidget(self.status_label)

        connection_group.setLayout(connection_layout)

        main.addWidget(connection_group)

        # ============================
        # Movement
        # ============================

        movement_group = QGroupBox("Keyboard control")
        movement_layout = QVBoxLayout()

        controls = QLabel(
            "↑  X-\n"
            "↓  X+\n"
            "←  Y-\n"
            "→  Y+\n\n"
            "Left / Right Shift  = Z+\n"
            "Left / Right Ctrl   = Z-\n\n"
            "Space = STOP\n"
            "Esc = STOP + Disable + Exit"
        )

        movement_layout.addWidget(controls)

        self.direction_label = QLabel(
            "Current movement: STOP"
        )

        movement_layout.addWidget(
            self.direction_label
        )

        self.stop_button = QPushButton("STOP")
        self.stop_button.setMinimumHeight(70)

        movement_layout.addWidget(
            self.stop_button
        )

        movement_group.setLayout(
            movement_layout
        )

        main.addWidget(movement_group)

        # ============================
        # Tools
        # ============================

        tool_group = QGroupBox("Tools / Digital Outputs")
        tool_layout = QVBoxLayout()

        # Tool 1
        tool1_row = QHBoxLayout()

        self.tool1_status = QLabel("Tool 1: OFF")

        self.tool1_on_button = QPushButton(
            "Tool 1 ON"
        )

        self.tool1_off_button = QPushButton(
            "Tool 1 OFF"
        )

        tool1_row.addWidget(self.tool1_status)
        tool1_row.addWidget(self.tool1_on_button)
        tool1_row.addWidget(self.tool1_off_button)

        tool_layout.addLayout(tool1_row)

        # Tool 2
        tool2_row = QHBoxLayout()

        self.tool2_status = QLabel("Tool 2: OFF")

        self.tool2_on_button = QPushButton(
            "Tool 2 ON"
        )

        self.tool2_off_button = QPushButton(
            "Tool 2 OFF"
        )

        tool2_row.addWidget(self.tool2_status)
        tool2_row.addWidget(self.tool2_on_button)
        tool2_row.addWidget(self.tool2_off_button)

        tool_layout.addLayout(tool2_row)

        tool_group.setLayout(tool_layout)

        main.addWidget(tool_group)

        # ============================
        # Exit
        # ============================

        self.exit_button = QPushButton(
            "Disable Robot + Exit"
        )

        main.addWidget(self.exit_button)

    # -----------------------------------------------------
    # Signals/buttons
    # -----------------------------------------------------

    def connect_signals(self):

        self.connect_button.clicked.connect(
            self.connect_robot
        )

        self.disable_button.clicked.connect(
            self.robot.disable
        )

        self.speed_input.valueChanged.connect(
            self.robot.set_speed
        )

        self.stop_button.clicked.connect(
            self.robot.stop
        )

        self.tool1_on_button.clicked.connect(
            lambda: self.robot.set_tool1(True)
        )

        self.tool1_off_button.clicked.connect(
            lambda: self.robot.set_tool1(False)
        )

        self.tool2_on_button.clicked.connect(
            lambda: self.robot.set_tool2(True)
        )

        self.tool2_off_button.clicked.connect(
            lambda: self.robot.set_tool2(False)
        )

        self.exit_button.clicked.connect(
            self.safe_exit
        )

        # Robot -> GUI
        self.signals.direction_changed.connect(
            self.update_direction
        )

        self.signals.status_changed.connect(
            self.status_label.setText
        )

        self.signals.tool1_changed.connect(
            self.update_tool1
        )

        self.signals.tool2_changed.connect(
            self.update_tool2
        )

        self.signals.request_close.connect(
            self.close
        )

    # -----------------------------------------------------
    # Connect robot
    # -----------------------------------------------------

    def connect_robot(self):

        ip = self.ip_input.text().strip()

        speed = self.speed_input.value()

        try:

            self.robot.connect_robot(
                ip,
                speed
            )

        except Exception as e:

            QMessageBox.critical(
                self,
                "Connection error",
                str(e)
            )

    # -----------------------------------------------------
    # Keyboard listener
    # -----------------------------------------------------

    def start_keyboard_listener(self):

        self.keyboard_listener = keyboard.Listener(
            on_press=self.robot.key_pressed,
            on_release=self.robot.key_released,
        )

        self.keyboard_listener.start()

    # -----------------------------------------------------
    # GUI updates
    # -----------------------------------------------------

    def update_direction(self, direction):

        self.direction_label.setText(
            f"Current movement: {direction}"
        )

    def update_tool1(self, state):

        self.tool1_status.setText(
            "Tool 1: ON"
            if state
            else "Tool 1: OFF"
        )

    def update_tool2(self, state):

        self.tool2_status.setText(
            "Tool 2: ON"
            if state
            else "Tool 2: OFF"
        )

    # -----------------------------------------------------
    # Exit
    # -----------------------------------------------------

    def safe_exit(self):

        self.robot.disable()

        self.close()

    def closeEvent(self, event):

        try:
            self.robot.disable()
        except Exception:
            pass

        if self.keyboard_listener:
            self.keyboard_listener.stop()

        event.accept()


# =========================================================
# Run
# =========================================================

if __name__ == "__main__":

    app = QApplication(sys.argv)

    window = MainWindow()

    window.show()

    sys.exit(app.exec())